{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-smoke-ledger-linkage-report.schema.json",
  "title": "Provider Smoke Ledger Linkage Report",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "linked_attempts", "provider_path_smoke_supported", "provider_backed_quality_supported", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-smoke-ledger-linkage-report-v1" },
    "artifact": { "const": "provider-smoke-ledger-linkage-report.json" },
    "status": { "enum": ["linked", "missing", "mismatch"] },
    "linked_attempts": { "type": "array", "items": { "type": "object" } },
    "provider_path_smoke_supported": { "type": "boolean" },
    "provider_backed_quality_supported": { "const": false },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
