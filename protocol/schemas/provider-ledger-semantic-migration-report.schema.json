{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-ledger-semantic-migration-report.schema.json",
  "title": "Provider Ledger Semantic Migration Report",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "migrations", "historical_attempt_ids_preserved", "legacy_attempt_type_preserved", "provider_execution_behavior_changed", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-ledger-semantic-migration-report-v1" },
    "artifact": { "const": "provider-ledger-semantic-migration-report.json" },
    "status": { "enum": ["migrated", "current", "not_required"] },
    "migrations": { "type": "array", "items": { "type": "object" } },
    "historical_attempt_ids_preserved": { "const": true },
    "legacy_attempt_type_preserved": { "const": true },
    "provider_execution_behavior_changed": { "const": false },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
