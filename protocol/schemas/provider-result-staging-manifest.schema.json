{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-result-staging-manifest.schema.json",
  "title": "Provider Result Staging Manifest",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "admitted_results", "admitted_result_ids", "provider_or_model_called_by_runtime", "target_files_mutated"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-result-staging-manifest-v1" },
    "artifact": { "const": "provider-result-staging-manifest.json" },
    "status": { "enum": ["admitted", "empty"] },
    "admitted_results": { "type": "array", "items": { "type": "object" } },
    "admitted_result_ids": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called_by_runtime": { "const": false },
    "target_files_mutated": { "const": false }
  },
  "additionalProperties": true
}
