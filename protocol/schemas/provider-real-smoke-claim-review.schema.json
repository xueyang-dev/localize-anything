{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-claim-review.schema.json",
  "title": "Provider Real Smoke Claim Review",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "forbidden_claims", "smoke_success_supports_provider_backed_quality", "limited_scope_becomes_global_readiness", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-claim-review-v1" },
    "artifact": { "const": "provider-real-smoke-claim-review.json" },
    "status": { "enum": ["non_claims_preserved", "claim_conflict"] },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "smoke_success_supports_provider_backed_quality": { "const": false },
    "limited_scope_becomes_global_readiness": { "const": false },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
