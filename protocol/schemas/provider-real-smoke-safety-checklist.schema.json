{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-safety-checklist.schema.json",
  "title": "Provider Real Smoke Safety Checklist",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "items", "all_confirmed", "execution_allowed_by_checklist_alone", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-safety-checklist-v1" },
    "artifact": { "const": "provider-real-smoke-safety-checklist.json" },
    "status": { "const": "manual_confirmation_required" },
    "items": { "type": "array", "minItems": 8, "items": { "type": "object", "required": ["check_id", "required", "confirmed"] } },
    "all_confirmed": { "const": false },
    "execution_allowed_by_checklist_alone": { "const": false },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
