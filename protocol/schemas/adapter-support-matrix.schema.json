{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/adapter-support-matrix.schema.json",
  "title": "Localize Anything Adapter Support Matrix",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "adapter_count", "adapters", "claim_boundaries"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-adapter-support-matrix-v1" },
    "artifact": { "const": "adapter-support-matrix.json" },
    "status": { "type": "string" },
    "adapter_count": { "type": "integer" },
    "adapters": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "contract_validation": { "type": "object" },
    "claim_boundaries": { "type": "object" }
  },
  "additionalProperties": true
}
