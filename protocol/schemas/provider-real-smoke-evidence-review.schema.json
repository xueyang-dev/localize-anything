{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-evidence-review.schema.json",
  "title": "Provider Real Smoke Evidence Review",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "evidence_chain", "sanitized_evidence_only", "blockers", "forbidden_claims", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-evidence-review-v1" },
    "artifact": { "const": "provider-real-smoke-evidence-review.json" },
    "status": { "enum": ["complete", "incomplete", "blocked"] },
    "evidence_chain": { "type": "object" },
    "sanitized_evidence_only": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
