{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-plan.schema.json",
  "title": "Provider Real Smoke Plan",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "execution_mode", "execution_performed", "ci_execution_allowed", "fixture_id", "required_evidence", "forbidden_claims", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-plan-v1" },
    "artifact": { "const": "provider-real-smoke-plan.json" },
    "status": { "enum": ["protocol_ready", "blocked"] },
    "execution_mode": { "const": "manual_local_explicit_outside_ci" },
    "execution_performed": { "const": false },
    "ci_execution_allowed": { "const": false },
    "fixture_id": { "type": "string" },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
