{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-mock-run-manifest.schema.json",
  "title": "Localize Anything Provider Mock Run Manifest",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "scenario", "status", "provider_backed", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-mock-run-manifest-v1" },
    "artifact": { "const": "provider-mock-run-manifest.json" },
    "scenario": { "type": "string" },
    "status": { "type": "string" },
    "provider_backed": { "const": false },
    "provider_or_model_called": { "const": false },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
