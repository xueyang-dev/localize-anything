{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-dry-run-plan.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "dry_run_only", "real_provider_execution_enabled", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "type": "string" },
    "schema": { "const": "localize-anything-provider-dry-run-plan-v1" },
    "artifact": { "const": "provider-dry-run-plan.json" },
    "status": { "type": "string" },
    "dry_run_only": { "const": true },
    "real_provider_execution_enabled": { "const": false },
    "provider_profile": { "type": "object" },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
