{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-acceptance-criteria.schema.json",
  "title": "Provider Real Smoke Acceptance Criteria",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "criteria", "outcomes", "successful_smoke_supports_provider_backed_quality", "forbidden_claims", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-acceptance-criteria-v1" },
    "artifact": { "const": "provider-real-smoke-acceptance-criteria.json" },
    "status": { "const": "defined" },
    "criteria": { "type": "array", "items": { "type": "object" } },
    "outcomes": { "type": "object", "required": ["pass", "partial", "fail"] },
    "successful_smoke_supports_provider_backed_quality": { "const": false },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
