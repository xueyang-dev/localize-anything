{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-consent-scope-diff.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "expected_scope", "provided_scope", "differences", "exact_match", "provider_or_model_called"],
  "properties": {
    "protocol_version": {"type": "string"},
    "schema": {"const": "localize-anything-provider-consent-scope-diff-v1"},
    "artifact": {"const": "provider-consent-scope-diff.json"},
    "status": {"enum": ["no_action", "incomplete", "stale", "scope_mismatch", "exact_match"]},
    "expected_scope": {"type": "object"},
    "provided_scope": {"type": "object"},
    "differences": {"type": "array"},
    "exact_match": {"type": "boolean"},
    "provider_or_model_called": {"const": false}
  },
  "additionalProperties": true
}
