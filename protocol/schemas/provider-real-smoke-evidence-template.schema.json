{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-evidence-template.schema.json",
  "title": "Provider Real Smoke Evidence Template",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "fixture_id", "segment_count", "authorization_decision", "attempt_state", "claim_boundary", "raw_output_committed", "credentials_recorded", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-evidence-template-v1" },
    "artifact": { "const": "provider-real-smoke-evidence-template.json" },
    "status": { "const": "unexecuted_template" },
    "fixture_id": { "type": "string" },
    "segment_count": { "type": "integer", "maximum": 2 },
    "authorization_decision": { "type": "string" },
    "attempt_state": { "type": "string" },
    "claim_boundary": { "type": "object" },
    "raw_output_committed": { "const": false },
    "credentials_recorded": { "const": false },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
