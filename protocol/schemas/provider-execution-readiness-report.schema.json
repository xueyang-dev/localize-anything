{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-execution-readiness-report.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "provider_backed_quality_supported", "forbidden_claims", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "type": "string" },
    "schema": { "const": "localize-anything-provider-execution-readiness-report-v1" },
    "artifact": { "const": "provider-execution-readiness-report.json" },
    "status": { "type": "string" },
    "provider_profile": { "type": "object" },
    "real_provider_execution_enabled": { "type": "boolean" },
    "provider_backed_quality_supported": { "const": false },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
