  "$id": "https://localize-anything.dev/schemas/provider-redaction-audit.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "secret_value_leak_count", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "type": "string" },
