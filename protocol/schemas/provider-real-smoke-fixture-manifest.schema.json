{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-fixture-manifest.schema.json",
  "title": "Provider Real Smoke Fixture Manifest",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "fixture_id", "status", "source_path", "source_sha256", "selected_keys", "segment_count", "public", "safe_to_disclose", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-fixture-manifest-v1" },
    "artifact": { "const": "provider-real-smoke-fixture-manifest.json" },
    "status": { "enum": ["public_safe", "missing"] },
    "fixture_id": { "type": "string" },
    "source_path": { "type": "string" },
    "source_sha256": { "type": "string" },
    "selected_keys": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
    "segment_count": { "type": "integer", "maximum": 2 },
    "public": { "const": true },
    "safe_to_disclose": { "const": true },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
