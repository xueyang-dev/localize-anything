{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/benchmark-dataset-manifest.schema.json",
  "title": "Localize Anything Benchmark Dataset Manifest",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "dataset_id", "benchmark_track", "reference_policy", "privacy_commercial_risk"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-benchmark-dataset-manifest-v1" },
    "artifact": { "const": "benchmark-dataset-manifest.json" },
    "status": { "type": "string" },
    "dataset_id": { "type": "string" },
    "benchmark_track": { "enum": ["controlled", "agent_system"] },
    "source_repo": { "type": "string" },
    "source_commit": { "type": "string" },
    "source_paths": { "type": "array", "items": { "type": "string" } },
    "source_locale": { "type": "string" },
    "target_locale": { "type": "string" },
    "reference_policy": { "type": "string" },
    "reference_visibility": { "type": "string" },
    "privacy_commercial_risk": { "type": "string" },
    "allowed_outputs": { "type": "object" },
    "claim_boundaries": { "type": "object" }
  },
  "additionalProperties": true
}
