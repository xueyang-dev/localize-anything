{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-real-smoke-ledger-audit.schema.json",
  "title": "Provider Real Smoke Ledger Audit",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "items", "summary", "ledger_is_execution_evidence_not_quality_evidence", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-real-smoke-ledger-audit-v1" },
    "artifact": { "const": "provider-real-smoke-ledger-audit.json" },
    "status": { "enum": ["consistent", "semantic_mismatch", "not_run"] },
    "items": { "type": "array", "items": { "type": "object", "required": ["attempt_id", "result_id", "status", "issues"] } },
    "summary": { "type": "object" },
    "ledger_is_execution_evidence_not_quality_evidence": { "const": true },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
