{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-consent-resolution-report.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "consent_granted", "consent_scope", "blockers", "provider_or_model_called"],
  "properties": {
    "protocol_version": {"type": "string"},
    "schema": {"const": "localize-anything-provider-consent-resolution-report-v1"},
    "artifact": {"const": "provider-consent-resolution-report.json"},
    "status": {"enum": ["pending", "granted", "denied", "revoked", "expired", "dry_run_only", "stale", "scope_mismatch"]},
    "consent_granted": {"type": "boolean"},
    "consent_scope": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "provider_or_model_called": {"const": false}
  },
  "additionalProperties": true
}
