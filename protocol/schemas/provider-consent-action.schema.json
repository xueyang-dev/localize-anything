{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-consent-action.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "action_id", "action", "actor_role", "actor_reference", "consent_scope", "status", "provider_or_model_called"],
  "properties": {
    "protocol_version": {"type": "string"},
    "schema": {"const": "localize-anything-provider-consent-action-v1"},
    "artifact": {"const": "provider-consent-actions.jsonl"},
    "action_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["grant", "deny", "revoke", "expire", "confirm_dry_run_only"]},
    "actor_role": {"type": "string", "minLength": 1},
    "actor_reference": {"type": "string", "minLength": 1},
    "consent_scope": {"type": "object", "minProperties": 9},
    "status": {"const": "recorded"},
    "provider_or_model_called": {"const": false}
  },
  "additionalProperties": true
}
