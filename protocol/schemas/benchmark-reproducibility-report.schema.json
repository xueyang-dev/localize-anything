{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/benchmark-reproducibility-report.schema.json",
  "title": "Localize Anything Benchmark Reproducibility Report",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "dataset_id", "benchmark_track", "missing_reproducibility_metadata"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-benchmark-reproducibility-report-v1" },
    "artifact": { "const": "benchmark-reproducibility-report.json" },
    "status": { "type": "string" },
    "dataset_id": { "type": "string" },
    "benchmark_track": { "type": "string" },
    "source_repo": { "type": "string" },
    "source_commit": { "type": "string" },
    "source_paths": { "type": "array", "items": { "type": "string" } },
    "target_locale": { "type": "string" },
    "reference_policy": { "type": "string" },
    "missing_reproducibility_metadata": { "type": "array", "items": { "type": "string" } },
    "supported_benchmark_claims": { "type": "array", "items": { "type": "string" } },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
