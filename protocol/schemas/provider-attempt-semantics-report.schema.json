{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-attempt-semantics-report.schema.json",
  "title": "Provider Attempt Semantics Report",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "items", "summary", "external_import_is_runtime_execution_evidence", "staging_admission_is_quality_evidence", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-attempt-semantics-report-v1" },
    "artifact": { "const": "provider-attempt-semantics-report.json" },
    "status": { "enum": ["consistent", "blocked", "not_run"] },
    "items": { "type": "array", "items": { "type": "object", "required": ["attempt_id", "attempt_type", "evidence_class", "status", "issues"] } },
    "summary": { "type": "object" },
    "external_import_is_runtime_execution_evidence": { "const": false },
    "staging_admission_is_quality_evidence": { "const": false },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
