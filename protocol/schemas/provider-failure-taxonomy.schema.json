{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-failure-taxonomy.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "failures", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "type": "string" },
    "schema": { "const": "localize-anything-provider-failure-taxonomy-v1" },
    "artifact": { "const": "provider-failure-taxonomy.json" },
    "status": { "type": "string" },
    "failures": { "type": "array", "items": { "type": "object" } },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
