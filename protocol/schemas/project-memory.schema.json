{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/project-memory.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "source_locale", "target_locale", "source_files", "product_context", "style_rules", "preserve_rules", "translation_memory", "confirmed_decisions"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-project-memory-v1" },
    "source_locale": { "type": "string", "minLength": 1 },
    "target_locale": { "type": "string", "minLength": 1 },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "adapter"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "adapter": { "enum": ["android", "gettext", "ios", "json", "structured", "xcstrings", "xliff"] }
        }
      }
    },
    "product_context": { "type": "string" },
    "style_rules": { "type": "array" },
    "preserve_rules": { "type": "array" },
    "translation_memory": { "type": "array" },
    "confirmed_decisions": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
