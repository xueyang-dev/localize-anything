{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-result-staging-admission.schema.json",
  "title": "Provider Result Staging Admission",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "items", "summary", "staging_admission_does_not_imply_provider_backed_quality", "provider_or_model_called_by_runtime"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-result-staging-admission-v1" },
    "artifact": { "const": "provider-result-staging-admission.json" },
    "status": { "enum": ["admitted", "mixed", "blocked"] },
    "items": { "type": "array", "items": { "type": "object", "required": ["result_id", "decision", "admitted", "blockers"] } },
    "summary": { "type": "object" },
    "staging_admission_does_not_imply_provider_backed_quality": { "const": true },
    "provider_or_model_called_by_runtime": { "const": false }
  },
  "additionalProperties": true
}
