{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-mock-response.schema.json",
  "title": "Localize Anything Provider Mock Response Record",
  "type": "object",
  "required": ["protocol_version", "schema", "mock_response_id", "scenario", "provider", "execution_mode", "provider_backed"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-provider-mock-response-record-v1" },
    "mock_response_id": { "type": "string" },
    "scenario": { "type": "string" },
    "provider": { "const": "mock" },
    "execution_mode": { "const": "provider_safe_mock" },
    "provider_backed": { "const": false },
    "segments": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
