{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/adapter-promotion-readiness-report.schema.json",
  "title": "Localize Anything Adapter Promotion Readiness Report",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "adapters", "summary"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-adapter-promotion-readiness-report-v1" },
    "artifact": { "const": "adapter-promotion-readiness-report.json" },
    "status": { "type": "string" },
    "adapters": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "source_artifact_references": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
