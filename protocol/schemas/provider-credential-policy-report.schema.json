{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/provider-credential-policy-report.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "secret_values_written", "provider_or_model_called"],
  "properties": {
    "protocol_version": { "type": "string" },
    "schema": { "const": "localize-anything-provider-credential-policy-report-v1" },
    "artifact": { "const": "provider-credential-policy-report.json" },
    "status": { "type": "string" },
    "credential_sources": { "type": "array", "items": { "type": "object" } },
    "allowed_environment_variable_names": { "type": "array", "items": { "type": "string" } },
    "secret_values_written": { "const": false },
    "provider_or_model_called": { "const": false }
  },
  "additionalProperties": true
}
