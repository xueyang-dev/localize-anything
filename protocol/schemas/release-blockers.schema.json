{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/release-blockers.schema.json",
  "title": "Localize Anything Release Blockers",
  "type": "object",
  "required": ["protocol_version", "schema", "artifact", "status", "blockers", "summary"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-release-blockers-v1" },
    "artifact": { "const": "release-blockers.json" },
    "status": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "release_policy": { "type": "object" }
  },
  "additionalProperties": true
}
