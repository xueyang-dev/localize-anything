{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localize-anything.dev/schemas/independent-review.schema.json",
  "type": "object",
  "required": ["protocol_version", "schema", "status", "reviewer", "review_items", "findings", "summary", "reviewed_at"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema": { "const": "localize-anything-independent-review-v1" },
    "status": { "const": "complete" },
    "reviewer": { "type": "string", "minLength": 1 },
    "review_items": {
      "type": "array",
      "description": "Auto-cleared or explicitly checked review items. These are not counted as findings.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocking", "actionable", "coverage_limitation", "informational"] },
          "status": { "const": "auto_cleared" },
          "note": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Independent-review issues requiring action, already resolved before report, or human confirmation.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocking", "actionable", "coverage_limitation", "informational"] },
          "status": { "enum": ["resolved", "needs_human_confirmation"] },
          "note": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["reviewed_count", "review_item_count", "finding_count", "human_confirmation_required"],
      "properties": {
        "reviewed_count": { "type": "integer", "minimum": 0 },
        "review_item_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "human_confirmation_required": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewed_at": { "type": "string", "format": "date-time" }
  }
}
